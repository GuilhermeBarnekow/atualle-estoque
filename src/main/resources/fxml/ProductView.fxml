<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.atualle.controller.ProductController" spacing="15" styleClass="content-pane">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Search Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Buscar:" styleClass="form-label"/>
        <TextField fx:id="searchField" promptText="Buscar por nome, SKU, cor, tamanho..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
        <Button text="Limpar" onAction="#handleClearSearch" styleClass="secondary-button"/>
    </HBox>

    <!-- Products Table -->
    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="photoColumn" text="Foto" prefWidth="80" resizable="false"/>
            <TableColumn fx:id="skuColumn" text="SKU" prefWidth="100"/>
            <TableColumn fx:id="nameColumn" text="Nome" prefWidth="200"/>
            <TableColumn fx:id="categoryColumn" text="Categoria" prefWidth="150"/>
            <TableColumn fx:id="colorColumn" text="Cor" prefWidth="100"/>
            <TableColumn fx:id="sizeColumn" text="Tamanho" prefWidth="100"/>
            <TableColumn fx:id="costColumn" text="Custo" prefWidth="100"/>
            <TableColumn fx:id="priceColumn" text="Preço" prefWidth="100"/>
            <TableColumn fx:id="quantityColumn" text="Quantidade" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Product Form -->
    <GridPane hgap="15" vgap="10" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120" maxWidth="120"/>
            <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Foto:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <ImageView fx:id="photoView" fitHeight="100" fitWidth="100" styleClass="photo-preview"/>
            <Button text="Selecionar Imagem" onAction="#handleSelectImage" styleClass="secondary-button"/>
        </HBox>

        <Label text="SKU:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="skuField" styleClass="form-field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Nome:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" styleClass="form-field" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Categoria:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="categoryComboBox" styleClass="form-field" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Cor:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="colorField" styleClass="form-field" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Tamanho:" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="sizeField" styleClass="form-field" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Custo:" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="costField" styleClass="form-field" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Preço:" styleClass="form-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="priceField" styleClass="form-field" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Quantidade:" styleClass="form-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextField fx:id="quantityField" styleClass="form-field" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Adicionar" onAction="#handleAddProduct" styleClass="primary-button">
            <tooltip>
                <Tooltip text="Adicionar novo produto (Ctrl+N)" />
            </tooltip>
        </Button>
        <Button text="Atualizar" onAction="#handleUpdateProduct" styleClass="primary-button">
            <tooltip>
                <Tooltip text="Atualizar produto selecionado" />
            </tooltip>
        </Button>
        <Button text="Deletar" onAction="#handleDeleteProduct" styleClass="danger-button">
            <tooltip>
                <Tooltip text="Deletar produto selecionado" />
            </tooltip>
        </Button>
    </HBox>
</VBox>
