<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.atualle.controller.CategoryController" spacing="15" styleClass="content-pane">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Search Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Buscar:" styleClass="form-label"/>
        <TextField fx:id="searchField" promptText="Buscar por nome da categoria" HBox.hgrow="ALWAYS" styleClass="search-field"/>
        <Button text="Limpar" onAction="#handleClearSearch" styleClass="secondary-button"/>
    </HBox>

    <!-- Categories Table -->
    <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="75" resizable="false"/>
            <TableColumn fx:id="nameColumn" text="Nome" prefWidth="200"/>
            <TableColumn fx:id="descriptionColumn" text="Descrição" prefWidth="300"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Category Form -->
    <GridPane hgap="15" vgap="10" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120" maxWidth="120"/>
            <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="ID:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="idField" styleClass="form-field" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="false"/>

        <Label text="Nome:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" styleClass="form-field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Descrição:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionField" styleClass="form-field" GridPane.rowIndex="2" GridPane.columnIndex="1" prefRowCount="3"/>
    </GridPane>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Adicionar" onAction="#handleAddCategory" styleClass="primary-button">
            <tooltip>
                <Tooltip text="Adicionar nova categoria" />
            </tooltip>
        </Button>
        <Button text="Atualizar" onAction="#handleUpdateCategory" styleClass="primary-button">
            <tooltip>
                <Tooltip text="Atualizar categoria selecionada" />
            </tooltip>
        </Button>
        <Button text="Deletar" onAction="#handleDeleteCategory" styleClass="danger-button">
            <tooltip>
                <Tooltip text="Deletar categoria selecionada" />
            </tooltip>
        </Button>
    </HBox>
</VBox>
